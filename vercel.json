{
  "version": 2,
  "name": "atomenergylaw",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "www.atom-energylaw.com/**/*.html", "use": "@vercel/static" },
    { "src": "www.atom-energylaw.com/assets/**", "use": "@vercel/static" },
    { "src": "www.atom-energylaw.com/site-content.json", "use": "@vercel/static" },
    { "src": "www.atom-energylaw.com/*.png", "use": "@vercel/static" },
    { "src": "www.atom-energylaw.com/*.ttf", "use": "@vercel/static" },
    { "src": "www.atom-energylaw.com/*.pdf", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/$1.js" },
    { "src": "/", "dest": "www.atom-energylaw.com/index.html" },
    { "src": "/index(?:\\.html)?", "dest": "www.atom-energylaw.com/index.html" },
    { "src": "/(about|expertise|expertise-sector|practice|sectors|services|news-updates|articles|insights-resources|contact|privacy-policy|anti-bribery-corruption-statement|meet-our-lawyers|admin|programme-qr)(?:\\.html)?", "dest": "www.atom-energylaw.com/$1.html" },
    { "src": "/(nmdpra|NMPDRA)(?:\\.html)?", "dest": "www.atom-energylaw.com/NMPDRA.html" },
    { "src": "/site-content\\.json", "dest": "www.atom-energylaw.com/site-content.json" },
    { "src": "/assets/(.*)", "dest": "www.atom-energylaw.com/assets/$1" },
    { "src": "/(Atom%20fav\\.png|centurygothic(?:_bold)?\\.ttf)", "dest": "www.atom-energylaw.com/$1" }
  ]
}
